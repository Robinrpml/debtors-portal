# Copy to .env.local for local dev. In production these live in Vercel → Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are visible to the browser; everything else is server-only.

NEXT_PUBLIC_SITE_URL=https://debtors.precisionthermal.com.au
NEXT_PUBLIC_SUPABASE_URL=https://btronlsgngjdzwfobgxn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # Supabase → Project Settings → API (publishable / anon key)
SUPABASE_SERVICE_ROLE_KEY=               # Supabase → Project Settings → API (service_role / secret key). Never expose.

# Random secrets — generate each with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=                    # encrypts the Xero refresh token at rest
CRON_SECRET=                             # Vercel Cron sends this as a Bearer token
ASCORA_WEBHOOK_SECRET=                   # appended as ?secret= to the Ascora web hook URL

# First Owner bootstrap (remove both after /setup has been used)
BOOTSTRAP_OWNER_EMAIL=robin@rpmlventures.com.au
BOOTSTRAP_TOKEN=

# Xero — developer.xero.com → New app → Web app
# Redirect URI: https://debtors.precisionthermal.com.au/api/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_NAME=DND Insulation          # optional: pick this org if several are authorised
# XERO_SCOPES=offline_access accounting.invoices.read accounting.payments.read accounting.contacts.read
# XERO_BRAND_CATEGORY=Brand

# Ascora — Administration → API
ASCORA_API_KEY=
# ASCORA_AUTH_HEADER=Auth
# Deep links: paste one real URL of each from Ascora and replace the ID with {id}
ASCORA_CUSTOMER_URL=
ASCORA_INVOICE_URL=
# Lets Managers change On Hold from the portal. Leave unset until tested on a dummy customer.
# ASCORA_HOLD_WRITE_ENABLED=true

# Missive — Settings → API → Create token
MISSIVE_API_TOKEN=
# MISSIVE_ACCOUNT_ADDRESSES=accounts@dndinsulation.com.au,accounts@gippslandinsulation.com.au

# Anthropic — console.anthropic.com → API keys (reads remittance emails)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
